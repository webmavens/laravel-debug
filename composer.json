{
    "name": "webmavens/debug-monitor",
    "description": "Laravel debug / data rule monitoring package",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Webmavens\\DebugMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webmavens\\DebugMonitor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webmavens\\DebugMonitor\\DebugMonitorServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "webmavens",
            "email": "info@webmavens.com"
        }
    ],
    "prefer-stable": true
}
